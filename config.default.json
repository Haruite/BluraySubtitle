{
  "schema_version": 1,
  "window": {
    "geometry": "",
    "log_geometry": ""
  },
  "ui": {
    "language": "en",
    "theme": "light",
    "font_size": 10,
    "opacity": 100,
    "save_log_to_file": false,
    "log_line_limit": 4000,
    "log_theme": "follow",
    "close_to_tray": true,
    "check_updates_on_startup": true,
    "main_background_path": "",
    "main_background_opacity": 20,
    "main_background_blur": 0,
    "log_background_path": "",
    "log_background_opacity": 20,
    "log_background_blur": 0,
    "fonts": {
      "interface": "",
      "table": "",
      "log": "",
      "editor": ""
    }
  },
  "startup": {
    "function_page": "bluray_remux",
    "episode_mode": "series"
  },
  "paths": {
    "remux_output": "",
    "encode_output": ""
  },
  "audio": {
    "flac_compression_level": 8,
    "ffmpeg_flac_compression_level": 8,
    "fdkaac_bitrate_kbps": 0,
    "opus_bitrate_kbps": 0,
    "duration_loss_fallback_threshold_seconds": 1.0
  },
  "remux": {
    "convert_lossless_audio_to_flac": true,
    "convert_immersive_audio_to_flac": false,
    "allow_partial_missing_non_video_tracks": false,
    "save_audio_gaps": false
  },
  "encode": {
    "encoder": "x265",
    "bit_depth": "10",
    "preset": "Balanced",
    "custom_presets": [],
    "lossless_audio_codec": "flac",
    "subtitle_mode": "external",
    "use_getnative": true,
    "auto_crop_black_borders": false,
    "output_comparison_images": true,
    "check_corrupted_frames": false,
    "frame_check_luma_psnr_threshold_db": 30.0,
    "frame_check_chroma_psnr_threshold_db": 30.0,
    "vpy_denoise_strength": 0.6,
    "vpy_dehalo_strength": 0.0,
    "vpy_dering_strength": 0.0,
    "vpy_deband_strength": 0.5,
    "vpy_antialiasing_strength": 0.5
  }
}
